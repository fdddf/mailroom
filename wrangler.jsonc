// Mailroom: one Worker serves the dashboard (static assets), the admin API,
// the integration API, public sign-up forms, the unsubscribe and confirmation
// pages and the images for HTML email;
// it also receives mail (Email Routing), sends it (Email Sending), runs
// broadcasts (cron) and records delivery events (queue).
//
// Nothing here needs editing to deploy: the first deploy creates the database,
// the bucket and the queue in your account. Setup: README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailroom",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",

  // The dashboard is a single-page app; everything else is the Worker's.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/u/*", "/c/*", "/subscribe/*", "/media/*"]
  },

  // Variables and custom domains are set on the Worker in the Cloudflare
  // dashboard, so a deploy keeps them and this file stays the same for everyone:
  //   ADMIN_PASSWORD   secret, required: the dashboard password
  //   PUBLIC_URL       optional: where recipients reach this Worker. Without it,
  //                    links in email use the address the dashboard is open on.
  //   BARK_SERVER_URL  optional: push notifications for new mail through Bark
  //   BARK_DEVICE_KEY  (https://bark.day.app), e.g. https://api.day.app and a secret
  "keep_vars": true,

  // Sends from any address on a domain onboarded to Cloudflare Email Sending.
  "send_email": [{ "name": "EMAIL" }],

  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: found by this name, or created on the first deploy.
      "database_name": "mailroom",
      "migrations_dir": "migrations"
    }
  ],

  // Attachments of received mail, and the images uploaded for HTML email.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mailroom" }],

  // Delivery events from Email Sending (delivered, bounced, …), one
  // subscription per sending domain (see docs/domains.md).
  "queues": {
    // The Worker only consumes this queue, and the code never uses the binding.
    // It is here because a deploy creates a queue only if it has a producer.
    "producers": [{ "binding": "EVENTS_QUEUE", "queue": "mailroom-events" }],
    "consumers": [{ "queue": "mailroom-events", "max_batch_size": 50, "max_batch_timeout": 5 }]
  },

  // Broadcasts go out a batch per minute.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
