// Mailroom: one Worker serves the dashboard (static assets), the admin API,
// the integration API, the unsubscribe pages and the images for HTML email;
// it also receives mail (Email Routing), sends it (Email Sending), runs
// broadcasts (cron) and records delivery events (queue).
//
// Setup, step by step: README.md. Values marked CHANGE ME are yours to fill in.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailroom",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",

  // The dashboard is a single-page app; everything else is the Worker's.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/u/*", "/media/*"]
  },

  // Optional: serve it on a hostname of yours instead of *.workers.dev.
  // "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],

  "vars": {
    // CHANGE ME: where this Worker is reachable. Unsubscribe links and the
    // images in HTML email point here, so recipients must be able to open it.
    "PUBLIC_URL": "https://mailroom.example.workers.dev"
    // Optional push notifications for new mail through Bark (https://bark.day.app):
    // "BARK_SERVER_URL": "https://api.day.app"  plus the secret BARK_DEVICE_KEY
  },
  // Secrets (npx wrangler secret put <NAME>):
  //   ADMIN_PASSWORD   required: the dashboard password
  //   BARK_DEVICE_KEY  optional, see above

  // Sends from any address on a domain onboarded to Cloudflare Email Sending.
  "send_email": [{ "name": "EMAIL" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailroom",
      // CHANGE ME: the id printed by `npx wrangler d1 create mailroom`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Attachments of received mail, and the images uploaded for HTML email.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mailroom" }],

  // Delivery events from Email Sending (delivered, bounced, …), one
  // subscription per sending domain (see docs/domains.md).
  "queues": {
    "consumers": [{ "queue": "mailroom-events", "max_batch_size": 50, "max_batch_timeout": 5 }]
  },

  // Broadcasts go out a batch per minute.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
